diff --git a/tapcrm/packages/server/src/modules/meetings/messages.ts b/tapcrm/packages/server/src/modules/meetings/messages.ts
new file mode 100644
index 0000000..2df4076
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/messages.ts
@@ -0,0 +1,133 @@
+import { loadConfig } from '../../config.js';
+import type { RequestContext } from '../../platform/dal/context.js';
+import type { Tx } from '../../platform/dal/db.js';
+import { addEmailToQueue, escapeHtml } from '../../platform/email/index.js';
+import { notify } from '../notifications/facade.js';
+import type { ClientContact } from './repository.js';
+
+/**
+ * Everything TapCRM tells people about meetings. Staff hear in the app (and
+ * the host by email for a new request); clients hear in the portal and by
+ * email. Google's own invitation carries the calendar entry when the event
+ * is on a Google Calendar.
+ *
+ * Emails are collected while the transaction runs and sent after it commits,
+ * so nobody is emailed about a change that rolled back.
+ */
+
+type NotifyCtx = Pick<RequestContext, 'organizationId' | 'principal'>;
+
+export interface QueuedEmail {
+  readonly to: string;
+  readonly subject: string;
+  readonly text: string;
+  readonly html: string;
+}
+
+export class Outbox {
+  readonly emails: QueuedEmail[] = [];
+
+  email(to: string | null | undefined, subject: string, lines: readonly string[], action?: { label: string; url: string }): void {
+    if (!to) return;
+    const text = [...lines, ...(action ? ['', `${action.label}: ${action.url}`] : [])].join('\n');
+    const html = [
+      ...lines.map((line) => (line ? `<p>${escapeHtml(line)}</p>` : '')),
+      action ? `<p><a href="${escapeHtml(action.url)}">${escapeHtml(action.label)}</a></p>` : '',
+    ].join('\n');
+    this.emails.push({ to, subject, text, html });
+  }
+
+  async flush(): Promise<void> {
+    for (const message of this.emails.splice(0)) {
+      try {
+        await addEmailToQueue(message.to, message.subject, { text: message.text, html: message.html });
+      } catch (cause) {
+        // The meeting change stands; a lost email must not undo it.
+        console.error('[meetings] email not queued', message.to, cause instanceof Error ? cause.message : cause);
+      }
+    }
+  }
+}
+
+/** "Tue, 10 Nov, 3:30 pm IST" in the reader's zone. */
+export function formatWhen(at: Date, zone: string): string {
+  try {
+    return new Intl.DateTimeFormat('en-IN', {
+      timeZone: zone, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
+    }).format(at);
+  } catch {
+    return at.toISOString();
+  }
+}
+
+export function portalUrl(): string {
+  return new URL('/client/meetings', loadConfig().CLIENT_ORIGIN).href;
+}
+
+export function staffUrl(meetingId: string): string {
+  return new URL(`/company/meetings?meeting=${meetingId}`, loadConfig().CLIENT_ORIGIN).href;
+}
+
+export const staffLink = (meetingId: string): string => `/company/meetings?meeting=${meetingId}`;
+const PORTAL_LINK = '/client/meetings';
+
+/** In the app for staff. */
+export async function tellStaff(
+  tx: Tx,
+  ctx: NotifyCtx,
+  userIds: readonly string[],
+  input: { type: string; title: string; body: string; meetingId: string; urgent?: boolean; includeActor?: boolean },
+): Promise<void> {
+  const users = [...new Set(userIds)].filter((id) => input.includeActor || id !== ctx.principal.id);
+  if (users.length === 0) return;
+  await notify(tx, ctx, {
+    type: input.type,
+    priority: input.urgent ? 'operational' : 'informational',
+    audience: { users },
+    title: input.title.slice(0, 200),
+    body: input.body.slice(0, 2000),
+    link: staffLink(input.meetingId),
+    metadata: { meetingId: input.meetingId },
+  });
+}
+
+/** In the portal and by email for the client's people. */
+export async function tellClient(
+  tx: Tx,
+  ctx: NotifyCtx,
+  outbox: Outbox,
+  contacts: readonly ClientContact[],
+  input: {
+    type: string;
+    title: string;
+    lines: readonly string[];
+    meetingId: string;
+    meetUrl?: string | null;
+    urgent?: boolean;
+    /** Also tell the client who made the change (a confirmation they want in writing). */
+    includeActor?: boolean;
+  },
+): Promise<void> {
+  const skip = (userId: string | null) => !input.includeActor && userId !== null && userId === ctx.principal.id;
+  const users = contacts.map((contact) => contact.userId).filter((id): id is string => id !== null && !skip(id));
+  if (users.length > 0) {
+    await notify(tx, ctx, {
+      type: input.type,
+      priority: input.urgent ? 'operational' : 'informational',
+      audience: { users },
+      title: input.title.slice(0, 200),
+      body: input.lines.filter(Boolean).join(' ').slice(0, 2000),
+      link: PORTAL_LINK,
+      metadata: { meetingId: input.meetingId },
+    });
+  }
+  for (const contact of contacts) {
+    if (skip(contact.userId)) continue;
+    outbox.email(
+      contact.email,
+      input.title,
+      [`Hello ${contact.name},`, '', ...input.lines, ...(input.meetUrl ? ['', `Join the meeting: ${input.meetUrl}`] : [])],
+      { label: 'Open your meetings', url: portalUrl() },
+    );
+  }
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/policy.ts b/tapcrm/packages/server/src/modules/meetings/policy.ts
new file mode 100644
index 0000000..58bcb42
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/policy.ts
@@ -0,0 +1,66 @@
+import { MATCH_NOTHING, registerResourcePolicy, type PolicyEvaluationContext, type ResourcePolicy, type SqlFragment } from '@tapcrm/authz';
+import type { Action, Scope } from '@tapcrm/contracts';
+import type { RequestContext } from '../../platform/dal/context.js';
+import { db } from '../../platform/dal/db.js';
+import { sql } from '../../platform/dal/sql.js';
+import type { MeetingResource, MeetingStatus } from './types.js';
+
+/**
+ * A meeting belongs to its host. `own` is the host's own meetings; a pool,
+ * team or department reaches the meetings hosted by the people in it, so a
+ * Supervisor, Team Lead or department head can answer, move, watch or join
+ * their people's meetings according to which action the scope is on.
+ * List queries alias the table `m`.
+ */
+export const meetingPolicy: ResourcePolicy<MeetingResource> = {
+  resourceType: 'meeting',
+  domain: 'business',
+  async check(ctx: PolicyEvaluationContext, _action: Action, resource: MeetingResource, scope: Scope) {
+    if (resource.organizationId !== ctx.organizationId) return false;
+    if (scope === 'own' || scope === 'participant') return resource.hostId === ctx.principal.id;
+    if (scope === 'pool') return (await ctx.scope.poolMemberIds(ctx)).has(resource.hostId);
+    if (scope === 'team') return resource.hostTeamId !== null && (await ctx.scope.teamIds(ctx)).has(resource.hostTeamId);
+    if (scope === 'department') {
+      const departmentId = await ctx.scope.departmentId(ctx);
+      return departmentId !== null && resource.hostDepartmentId === departmentId;
+    }
+    return false;
+  },
+  async filter(ctx: PolicyEvaluationContext, _action: Action, scope: Scope): Promise<SqlFragment> {
+    if (scope === 'own' || scope === 'participant') return { sql: 'm.host_id = $1', parameters: [ctx.principal.id] };
+    if (scope === 'pool') {
+      const ids = [...(await ctx.scope.poolMemberIds(ctx))];
+      return ids.length ? { sql: 'm.host_id = ANY($1::uuid[])', parameters: [ids] } : MATCH_NOTHING;
+    }
+    if (scope === 'team') {
+      const ids = [...(await ctx.scope.teamIds(ctx))];
+      return ids.length
+        ? { sql: 'm.host_id IN (SELECT scope_user.id FROM app_user scope_user WHERE scope_user.organization_id = m.organization_id AND scope_user.team_id = ANY($1::uuid[]))', parameters: [ids] }
+        : MATCH_NOTHING;
+    }
+    if (scope === 'department') {
+      const departmentId = await ctx.scope.departmentId(ctx);
+      return departmentId
+        ? { sql: 'm.host_id IN (SELECT scope_user.id FROM app_user scope_user WHERE scope_user.organization_id = m.organization_id AND scope_user.department_id = $1)', parameters: [departmentId] }
+        : MATCH_NOTHING;
+    }
+    return MATCH_NOTHING;
+  },
+  participantFields: () => ['hostId'],
+  initiatorField: () => null,
+};
+
+export function registerMeetingPolicies(): void {
+  registerResourcePolicy(meetingPolicy);
+}
+
+export async function loadMeetingResource(ctx: RequestContext, id: string): Promise<MeetingResource | null> {
+  const row = await db.maybeOne<{ id: string; organizationId: string; hostId: string; hostTeamId: string | null; hostDepartmentId: string | null; status: MeetingStatus }>(ctx, sql`
+    SELECT m.id, m.organization_id AS "organizationId", m.host_id AS "hostId",
+           host.team_id AS "hostTeamId", host.department_id AS "hostDepartmentId", m.status
+      FROM meeting m
+      JOIN app_user host ON host.organization_id = m.organization_id AND host.id = m.host_id
+     WHERE m.organization_id = ${ctx.organizationId} AND m.id = ${id}
+  `);
+  return row ? { type: 'meeting', ...row } : null;
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/repository.ts b/tapcrm/packages/server/src/modules/meetings/repository.ts
