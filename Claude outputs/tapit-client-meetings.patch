@@ -0,0 +1,109 @@
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+
+beforeAll(async () => {
+  // The config loader wants a whole environment; nothing here connects to it.
+  process.env['DATABASE_URL'] ??= 'postgres://x:y@127.0.0.1:1/z';
+  process.env['REDIS_URL'] ??= 'redis://127.0.0.1:59999';
+  process.env['JWT_ACCESS_SECRET'] ??= 'a'.repeat(40);
+  process.env['JWT_REFRESH_SECRET'] ??= 'b'.repeat(40);
+  process.env['MEETINGS_TOKEN_ENCRYPTION_KEY'] ??= '5f2b8c0e9d4a7b1c3e6f8a0b2d4c6e8f1a3b5c7d9e0f2a4b6c8d0e2f4a6b8c0d';
+  (await import('../../../config.js')).__resetConfig();
+});
+
+const { CalendarAuthError, addGuest, deleteEvent, freeBusy, insertEvent, moveEvent } = await import('./calendar.js');
+const { openSecret, sealSecret } = await import('./crypto.js');
+
+interface Call { url: string; method: string; body: unknown }
+
+function stubFetch(responses: Array<{ status?: number; body?: unknown }>): Call[] {
+  const calls: Call[] = [];
+  let index = 0;
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init: RequestInit) => {
+    calls.push({ url: String(url), method: init.method ?? 'GET', body: typeof init.body === 'string' ? JSON.parse(init.body) : undefined });
+    const next = responses[Math.min(index, responses.length - 1)]!;
+    index += 1;
+    return new Response(next.status === 204 ? null : JSON.stringify(next.body ?? {}), { status: next.status ?? 200 });
+  }));
+  return calls;
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('Google Calendar client', () => {
+  it('reads busy times from the primary calendar', async () => {
+    const calls = stubFetch([{ body: { calendars: { primary: { busy: [{ start: '2026-11-12T05:30:00Z', end: '2026-11-12T06:30:00Z' }] } } } }]);
+    const busy = await freeBusy('token', new Date('2026-11-12T00:00:00Z'), new Date('2026-11-13T00:00:00Z'));
+    expect(busy).toEqual([{ start: new Date('2026-11-12T05:30:00Z'), end: new Date('2026-11-12T06:30:00Z') }]);
+    expect(calls[0]!.url).toMatch(/\/calendar\/v3\/freeBusy$/);
+    expect(calls[0]!.body).toMatchObject({ items: [{ id: 'primary' }] });
+  });
+
+  it('creates the event with a new Meet conference and has Google invite the guests', async () => {
+    const calls = stubFetch([{ body: { id: 'evt1', conferenceData: { entryPoints: [{ entryPointType: 'video', uri: 'https://meet.google.com/abc-defg-hij' }] } } }]);
+    const event = await insertEvent('token', {
+      summary: 'Storefront review',
+      description: 'Agenda',
+      start: new Date('2026-11-12T09:30:00Z'),
+      end: new Date('2026-11-12T10:00:00Z'),
+      timeZone: 'Asia/Kolkata',
+      guests: [{ email: 'riya@example.com', name: 'Riya' }],
+      requestId: 'req-1',
+    });
+    expect(event).toEqual({ eventId: 'evt1', meetUrl: 'https://meet.google.com/abc-defg-hij' });
+    expect(calls[0]!.url).toContain('conferenceDataVersion=1');
+    expect(calls[0]!.url).toContain('sendUpdates=all');
+    expect(calls[0]!.body).toMatchObject({
+      attendees: [{ email: 'riya@example.com', displayName: 'Riya' }],
+      conferenceData: { createRequest: { requestId: 'req-1', conferenceSolutionKey: { type: 'hangoutsMeet' } } },
+    });
+  });
+
+  it('reads the event back while Google is still making the conference', async () => {
+    const calls = stubFetch([
+      { body: { id: 'evt2', conferenceData: { createRequest: { status: { statusCode: 'pending' } } } } },
+      { body: { id: 'evt2', hangoutLink: 'https://meet.google.com/xyz-abcd-efg' } },
+    ]);
+    const event = await insertEvent('token', {
+      summary: 's', description: 'd', start: new Date(), end: new Date(Date.now() + 1_800_000), timeZone: 'UTC', guests: [], requestId: 'req-2',
+    });
+    expect(event.meetUrl).toBe('https://meet.google.com/xyz-abcd-efg');
+    expect(calls[1]!.method).toBe('GET');
+  });
+
+  it('moves the event and tells the guests; adds a guest quietly; cancels for everyone', async () => {
+    const calls = stubFetch([
+      { body: {} },
+      { body: { id: 'evt3', attendees: [{ email: 'riya@example.com' }] } },
+      { body: {} },
+      { status: 204 },
+    ]);
+    await moveEvent('token', 'evt3', new Date('2026-11-12T11:00:00Z'), new Date('2026-11-12T11:30:00Z'), 'Asia/Kolkata');
+    await addGuest('token', 'evt3', { email: 'admin@example.com', name: 'Admin' });
+    await deleteEvent('token', 'evt3');
+    expect(calls[0]).toMatchObject({ method: 'PATCH', body: { start: { dateTime: '2026-11-12T11:00:00.000Z' } } });
+    expect(calls[0]!.url).toContain('sendUpdates=all');
+    expect(calls[2]!.url).toContain('sendUpdates=none');
+    expect(calls[2]!.body).toEqual({ attendees: [{ email: 'riya@example.com' }, { email: 'admin@example.com', displayName: 'Admin' }] });
+    expect(calls[3]).toMatchObject({ method: 'DELETE' });
+    expect(calls[3]!.url).toContain('sendUpdates=all');
+  });
+
+  it('treats an event already deleted in Google as cancelled', async () => {
+    stubFetch([{ status: 410, body: { error: { message: 'Resource has been deleted' } } }]);
+    await expect(deleteEvent('token', 'gone')).resolves.toBeUndefined();
+  });
+
+  it('reports a refused token so the person can reconnect', async () => {
+    stubFetch([{ status: 401, body: { error: { message: 'Invalid Credentials' } } }]);
+    await expect(freeBusy('bad', new Date(), new Date())).rejects.toBeInstanceOf(CalendarAuthError);
+  });
+});
+
+describe('stored calendar tokens', () => {
+  it('open only for the person they were sealed for', () => {
+    const sealed = sealSecret('refresh-token', 'org-1', 'user-1');
+    expect(sealed).not.toContain('refresh-token');
+    expect(openSecret(sealed, 'org-1', 'user-1')).toBe('refresh-token');
+    expect(() => openSecret(sealed, 'org-1', 'user-2')).toThrow();
+  });
+});
diff --git a/tapcrm/packages/server/src/modules/meetings/google/calendar.ts b/tapcrm/packages/server/src/modules/meetings/google/calendar.ts
new file mode 100644
index 0000000..e79fc13
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/google/calendar.ts
@@ -0,0 +1,167 @@
+import { loadConfig } from '../../../config.js';
+
+/**
+ * Google Calendar v3 over plain fetch: free/busy, and events with a Google
+ * Meet conference. Every call acts on the token holder's primary calendar.
+ *
+ *   freeBusy        POST /calendar/v3/freeBusy
+ *   insert          POST /calendar/v3/calendars/primary/events
+ *                   ?conferenceDataVersion=1&sendUpdates=all — the new
+ *                   conference (a fresh Meet link per event, as Google
+ *                   recommends) and Google's own invitations to every guest
+ *   patch / delete  the same event, with sendUpdates so guests hear about it
+ */
+
+export const CALENDAR_SCOPES = [
+  'https://www.googleapis.com/auth/calendar.events',
+  'https://www.googleapis.com/auth/calendar.freebusy',
+] as const;
+
+/** Google refused the token: the person has to connect again. */
+export class CalendarAuthError extends Error {}
+/** Anything else that went wrong talking to Google. */
+export class CalendarError extends Error {
+  constructor(message: string, readonly status: number | null = null) {
+    super(message);
+  }
+}
+
+export interface BusyInterval {
+  readonly start: Date;
+  readonly end: Date;
+}
+
+export interface CalendarGuest {
+  readonly email: string;
+  readonly name?: string | null;
+}
+
+export interface NewCalendarEvent {
+  readonly summary: string;
+  readonly description: string;
+  readonly start: Date;
+  readonly end: Date;
+  readonly timeZone: string;
+  readonly guests: readonly CalendarGuest[];
+  /** Unique per attempt; Google ignores a repeated conference request id. */
+  readonly requestId: string;
+}
+
+export interface CalendarEvent {
+  readonly eventId: string;
+  readonly meetUrl: string | null;
+}
+
+interface GoogleEvent {
+  readonly id?: string;
+  readonly hangoutLink?: string;
+  readonly attendees?: ReadonlyArray<{ email?: string; displayName?: string; responseStatus?: string; organizer?: boolean }>;
+  readonly conferenceData?: {
+    readonly entryPoints?: ReadonlyArray<{ entryPointType?: string; uri?: string }>;
+    readonly createRequest?: { status?: { statusCode?: string } };
+  };
+}
+
+function base(): string {
+  return `${loadConfig().GOOGLE_API_BASE_URL.replace(/\/$/, '')}/calendar/v3`;
+}
+
+async function call<T>(token: string, method: string, path: string, body?: unknown): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${base()}${path}`, {
+      method,
+      headers: {
+        authorization: `Bearer ${token}`,
+        ...(body === undefined ? {} : { 'content-type': 'application/json' }),
+      },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      signal: AbortSignal.timeout(15_000),
+    });
+  } catch (cause) {
+    throw new CalendarError(`Google Calendar unreachable: ${cause instanceof Error ? cause.message : String(cause)}`);
+  }
+  if (response.status === 204 || (method === 'DELETE' && response.ok)) return undefined as T;
+  const payload = (await response.json().catch(() => ({}))) as { error?: { message?: string; status?: string } } & T;
+  if (response.status === 401 || response.status === 403) {
+    throw new CalendarAuthError(payload.error?.message ?? `Google refused access (HTTP ${response.status})`);
+  }
+  if (!response.ok) {
+    throw new CalendarError(payload.error?.message ?? `Google Calendar answered HTTP ${response.status}`, response.status);
+  }
+  return payload;
+}
+
+function meetUrlOf(event: GoogleEvent): string | null {
+  const video = event.conferenceData?.entryPoints?.find((entry) => entry.entryPointType === 'video')?.uri;
+  return video ?? event.hangoutLink ?? null;
+}
+
+/** Busy times on the token holder's primary calendar between the two instants. */
+export async function freeBusy(token: string, from: Date, to: Date): Promise<BusyInterval[]> {
+  const result = await call<{ calendars?: Record<string, { busy?: Array<{ start: string; end: string }>; errors?: unknown[] }> }>(
+    token,
+    'POST',
+    '/freeBusy',
+    { timeMin: from.toISOString(), timeMax: to.toISOString(), items: [{ id: 'primary' }] },
+  );
+  const calendar = result.calendars?.['primary'] ?? Object.values(result.calendars ?? {})[0];
+  if (!calendar) return [];
+  if (calendar.errors?.length) throw new CalendarError('Google could not read this calendar');
+  return (calendar.busy ?? []).map((slot) => ({ start: new Date(slot.start), end: new Date(slot.end) }));
+}
+
+/** Creates the event with a Meet link and has Google invite every guest. */
+export async function insertEvent(token: string, input: NewCalendarEvent): Promise<CalendarEvent> {
+  const body = {
+    summary: input.summary,
+    description: input.description,
+    start: { dateTime: input.start.toISOString(), timeZone: input.timeZone },
+    end: { dateTime: input.end.toISOString(), timeZone: input.timeZone },
+    attendees: input.guests.map((guest) => ({ email: guest.email, ...(guest.name ? { displayName: guest.name } : {}) })),
+    guestsCanInviteOthers: false,
+    reminders: { useDefault: true },
+    conferenceData: {
+      createRequest: { requestId: input.requestId, conferenceSolutionKey: { type: 'hangoutsMeet' } },
+    },
+  };
+  let event = await call<GoogleEvent>(token, 'POST', '/calendars/primary/events?conferenceDataVersion=1&sendUpdates=all', body);
+  const eventId = event.id;
+  if (!eventId) throw new CalendarError('Google did not return the new event');
+  // The conference is usually ready at once; when Google is still making it,
+  // read the event back briefly.
+  for (let attempt = 0; attempt < 3 && !meetUrlOf(event); attempt += 1) {
+    if (event.conferenceData?.createRequest?.status?.statusCode === 'failure') break;
+    await new Promise((resolve) => setTimeout(resolve, 800));
+    event = await call<GoogleEvent>(token, 'GET', `/calendars/primary/events/${encodeURIComponent(eventId)}`);
+  }
+  return { eventId, meetUrl: meetUrlOf(event) };
+}
+
+/** Moves the event; Google tells the guests. The Meet link stays the same. */
+export async function moveEvent(token: string, eventId: string, start: Date, end: Date, timeZone: string): Promise<void> {
+  await call(token, 'PATCH', `/calendars/primary/events/${encodeURIComponent(eventId)}?conferenceDataVersion=1&sendUpdates=all`, {
+    start: { dateTime: start.toISOString(), timeZone },
+    end: { dateTime: end.toISOString(), timeZone },
+  });
+}
+
+/** Adds someone to the guest list without emailing the others. */
+export async function addGuest(token: string, eventId: string, guest: CalendarGuest): Promise<void> {
+  const event = await call<GoogleEvent>(token, 'GET', `/calendars/primary/events/${encodeURIComponent(eventId)}`);
+  const attendees = [...(event.attendees ?? [])];
+  if (attendees.some((attendee) => attendee.email?.toLowerCase() === guest.email.toLowerCase())) return;
+  attendees.push({ email: guest.email, ...(guest.name ? { displayName: guest.name } : {}) });
+  await call(token, 'PATCH', `/calendars/primary/events/${encodeURIComponent(eventId)}?sendUpdates=none`, { attendees });
+}
+
+/** Cancels the event; Google tells the guests. */
+export async function deleteEvent(token: string, eventId: string): Promise<void> {
+  try {
+    await call(token, 'DELETE', `/calendars/primary/events/${encodeURIComponent(eventId)}?sendUpdates=all`);
+  } catch (cause) {
+    // Already gone from the calendar (deleted there by hand): nothing to cancel.
+    if (cause instanceof CalendarError && (cause.status === 404 || cause.status === 410)) return;
+    throw cause;
+  }
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/google/connect.ts b/tapcrm/packages/server/src/modules/meetings/google/connect.ts
new file mode 100644
index 0000000..4abc3e2
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/google/connect.ts
@@ -0,0 +1,231 @@
+import { randomBytes } from 'node:crypto';
+import { Router, type Request, type Response } from 'express';
+import { z } from 'zod';
+import { loadConfig } from '../../../config.js';
+import { ApplicationError } from '../../../errors.js';
+import type { RequestContext } from '../../../platform/dal/context.js';
+import { db } from '../../../platform/dal/db.js';
+import { sql } from '../../../platform/dal/sql.js';
+import {
+  GoogleAuthUnavailableError,
+  exchangeGoogleAuthorizationCode,
+  revokeGoogleToken,
+} from '../../../platform/integrations/google/token.js';
+import { calendarMode, forgetCalendarToken, type CalendarMode } from './access.js';
+import { CALENDAR_SCOPES } from './calendar.js';
+import { hashState, openSecret, sameHash, sealSecret } from './crypto.js';
+
+/**
+ * "Connect Google Calendar" (MEETINGS_GOOGLE_AUTH=oauth).
+ *
+ * Bearer-token sessions cannot ride along on Google's redirect, so the
+ * callback only relays the short-lived code to the app in a URL fragment and
+ * the app completes the sign-in through the authenticated API. A random state,
+ * kept as a hash in a single-use row and in an HttpOnly cookie for this
+ * browser, ties the two legs together (the Social module does the same).
+ */
+
+const COOKIE = 'tapcrm_calendar_oauth';
+const STATE_TTL_MS = 10 * 60_000;
+
+/** Both legs — Google's callback and the app's completion call — live under here. */
+function cookiePath(): string {
+  return `${loadConfig().API_BASE_PATH}/meetings`;
+}
+
+function apiOrigin(): URL {
+  return new URL(loadConfig().CLIENT_ORIGIN);
+}
+
+export function calendarRedirectUri(): string {
+  return new URL(`${loadConfig().API_BASE_PATH}/meetings/google/callback`, apiOrigin()).href;
+}
+
+function cookieValue(req: Request): string {
+  const entry = (req.headers.cookie ?? '')
+    .split(';')
+    .map((part) => part.trim())
+    .find((part) => part.startsWith(`${COOKIE}=`));
+  return entry ? decodeURIComponent(entry.slice(COOKIE.length + 1)) : '';
+}
+
+function invalid(message = 'This Google sign-in has expired or was already used. Start again.'): ApplicationError {
+  return new ApplicationError(message, 422, 'MEETINGS_CALENDAR_SIGN_IN_INVALID');
+}
+
+export interface CalendarConnectionStatus {
+  readonly mode: CalendarMode;
+  readonly connected: boolean;
+  readonly accountEmail: string | null;
+  readonly needsReconnect: boolean;
+  readonly lastError: string | null;
+  readonly connectedAt: Date | null;
+}
+
+export async function calendarConnectionStatus(ctx: RequestContext): Promise<CalendarConnectionStatus> {
+  const mode = calendarMode();
+  if (mode !== 'oauth') {
+    return { mode, connected: mode === 'service-account', accountEmail: null, needsReconnect: false, lastError: null, connectedAt: null };
+  }
+  const row = await db.maybeOne<{ accountEmail: string | null; status: string; lastError: string | null; connectedAt: Date }>(ctx, sql`
+    SELECT account_email::text AS "accountEmail", status, last_error AS "lastError", connected_at AS "connectedAt"
+      FROM calendar_connection WHERE organization_id = ${ctx.organizationId} AND user_id = ${ctx.principal.id}
+  `);
+  return {
+    mode,
+    connected: row?.status === 'active',
+    accountEmail: row?.accountEmail ?? null,
+    needsReconnect: row?.status === 'needs_reconnect',
+    lastError: row?.lastError ?? null,
+    connectedAt: row?.connectedAt ?? null,
+  };
+}
+
+function requireOauthMode(): void {
+  if (calendarMode() !== 'oauth') {
+    throw new ApplicationError(
+      'Google Calendar connections are not switched on for this company (MEETINGS_GOOGLE_AUTH).',
+      409,
+      'MEETINGS_CALENDAR_NOT_CONFIGURED',
+    );
+  }
+}
+
+export async function startCalendarConnect(ctx: RequestContext, res: Response): Promise<{ authorizationUrl: string }> {
+  requireOauthMode();
+  const config = loadConfig();
+  if (!config.GOOGLE_OAUTH_CLIENT_ID) throw new ApplicationError('GOOGLE_OAUTH_CLIENT_ID is not set.', 503, 'MEETINGS_CALENDAR_NOT_CONFIGURED');
+  const state = randomBytes(32).toString('base64url');
+  const stateHash = hashState(state);
+  await db.transaction(ctx, async (tx) => {
+    await tx.query(sql`DELETE FROM calendar_oauth_state WHERE organization_id = ${ctx.organizationId} AND expires_at < now()`);
+    await tx.query(sql`
+      INSERT INTO calendar_oauth_state (organization_id, state_hash, user_id, expires_at)
+      VALUES (${ctx.organizationId}, ${stateHash}, ${ctx.principal.id}, ${new Date(Date.now() + STATE_TTL_MS)})
+    `);
+  });
+  res.cookie(COOKIE, stateHash, {
+    httpOnly: true,
+    secure: apiOrigin().protocol === 'https:',
+    sameSite: 'lax',
+    path: cookiePath(),
+    maxAge: STATE_TTL_MS,
+  });
+  const url = new URL(config.GOOGLE_AUTHORIZE_URL);
+  url.search = new URLSearchParams({
+    client_id: config.GOOGLE_OAUTH_CLIENT_ID,
+    redirect_uri: calendarRedirectUri(),
+    response_type: 'code',
+    scope: ['openid', 'email', ...CALENDAR_SCOPES].join(' '),
+    access_type: 'offline',
+    // Always ask, so Google returns a refresh token even on a reconnect.
+    prompt: 'consent',
+    include_granted_scopes: 'true',
+    state,
+  }).toString();
+  return { authorizationUrl: url.href };
+}
+
+/** The email Google put in the ID token it just issued over TLS to us. */
+function emailFromIdToken(idToken: string | null): string | null {
+  if (!idToken) return null;
+  try {
+    const payload = JSON.parse(Buffer.from(idToken.split('.')[1] ?? '', 'base64url').toString('utf8')) as { email?: unknown };
+    return typeof payload.email === 'string' ? payload.email : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function completeCalendarConnect(
+  ctx: RequestContext,
+  input: { code: string; state: string },
+  req: Request,
+  res: Response,
+): Promise<CalendarConnectionStatus> {
+  requireOauthMode();
+  const stateHash = hashState(input.state);
+  if (!sameHash(cookieValue(req), stateHash)) throw invalid('Finish connecting in the same browser you started in.');
+  const consumed = await db.transaction(ctx, (tx) => tx.maybeOne<{ userId: string }>(sql`
+    UPDATE calendar_oauth_state SET consumed_at = now()
+     WHERE organization_id = ${ctx.organizationId} AND state_hash = ${stateHash}
+       AND user_id = ${ctx.principal.id} AND consumed_at IS NULL AND expires_at > now()
+    RETURNING user_id AS "userId"
+  `));
+  if (!consumed) throw invalid();
+  res.clearCookie(COOKIE, { path: cookiePath() });
+
+  let exchanged;
+  try {
+    exchanged = await exchangeGoogleAuthorizationCode(input.code, calendarRedirectUri());
+  } catch (cause) {
+    if (cause instanceof GoogleAuthUnavailableError) throw invalid(cause.message);
+    throw cause;
+  }
+  const granted = new Set(exchanged.scope.split(' '));
+  const missing = CALENDAR_SCOPES.filter((scope) => !granted.has(scope));
+  if (missing.length > 0) {
+    await revokeGoogleToken(exchanged.refreshToken ?? exchanged.accessToken);
+    throw new ApplicationError(
+      'Google did not give TapCRM access to your calendar. Connect again and leave both calendar permissions ticked.',
+      422,
+      'MEETINGS_CALENDAR_SCOPES_MISSING',
+    );
+  }
+  if (!exchanged.refreshToken) {
+    throw new ApplicationError(
+      'Google did not return a long-lived sign-in. Remove TapCRM from your Google account’s third-party access, then connect again.',
+      422,
+      'MEETINGS_CALENDAR_NO_REFRESH_TOKEN',
+    );
+  }
+  const sealed = sealSecret(exchanged.refreshToken, ctx.organizationId, ctx.principal.id);
+  await db.transaction(ctx, (tx) => tx.query(sql`
+    INSERT INTO calendar_connection (organization_id, user_id, provider, account_email, credentials_encrypted, scopes, status, last_error, connected_at)
+    VALUES (${ctx.organizationId}, ${ctx.principal.id}, 'google', ${emailFromIdToken(exchanged.idToken)}, ${sealed},
+            ${[...granted]}::text[], 'active', NULL, now())
+    ON CONFLICT (organization_id, user_id) DO UPDATE
+       SET account_email = EXCLUDED.account_email, credentials_encrypted = EXCLUDED.credentials_encrypted,
+           scopes = EXCLUDED.scopes, status = 'active', last_error = NULL, connected_at = now()
+  `));
+  forgetCalendarToken(ctx.organizationId, ctx.principal.id);
+  return calendarConnectionStatus(ctx);
+}
+
+export async function disconnectCalendar(ctx: RequestContext): Promise<CalendarConnectionStatus> {
+  const row = await db.transaction(ctx, (tx) => tx.maybeOne<{ sealed: string }>(sql`
+    DELETE FROM calendar_connection WHERE organization_id = ${ctx.organizationId} AND user_id = ${ctx.principal.id}
+    RETURNING credentials_encrypted AS sealed
+  `));
+  forgetCalendarToken(ctx.organizationId, ctx.principal.id);
+  if (row) {
+    try {
+      await revokeGoogleToken(openSecret(row.sealed, ctx.organizationId, ctx.principal.id));
+    } catch {
+      // The row is gone either way; an unreadable token cannot be revoked.
+    }
+  }
+  return calendarConnectionStatus(ctx);
+}
+
+/** Google's redirect lands here; the code travels on to the app in a fragment. */
+export function buildCalendarOAuthRouter(): Router {
+  const router = Router();
+  router.get('/callback', (req, res) => {
+    res.setHeader('Cache-Control', 'no-store');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    const destination = new URL('/company/meetings/calendar', apiOrigin());
+    try {
+      const state = z.string().min(1).max(512).parse(req.query['state']);
+      if (!sameHash(cookieValue(req), hashState(state))) throw new Error('browser mismatch');
+      const fragment = req.query['error']
+        ? new URLSearchParams({ calendar_error: 'denied' })
+        : new URLSearchParams({ calendar_code: z.string().min(1).max(4096).parse(req.query['code']), calendar_state: state });
+      destination.hash = fragment.toString();
+    } catch {
+      destination.hash = new URLSearchParams({ calendar_error: 'invalid' }).toString();
+    }
+    res.redirect(303, destination.href);
+  });
+  return router;
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/google/crypto.ts b/tapcrm/packages/server/src/modules/meetings/google/crypto.ts
new file mode 100644
index 0000000..abfcdfd
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/google/crypto.ts
@@ -0,0 +1,53 @@
+import { createCipheriv, createDecipheriv, createHash, randomBytes, timingSafeEqual } from 'node:crypto';
+import { loadConfig } from '../../../config.js';
+import { ApplicationError } from '../../../errors.js';
+
+/**
+ * Seals a person's Google refresh token with MEETINGS_TOKEN_ENCRYPTION_KEY
+ * (AES-256-GCM). The ciphertext is bound to its owner, so a sealed token copied
+ * onto another person's row does not open.
+ */
+
+function key(): Buffer {
+  const raw = loadConfig().MEETINGS_TOKEN_ENCRYPTION_KEY ?? '';
+  const bytes = /^[a-f0-9]{64}$/i.test(raw) ? Buffer.from(raw, 'hex') : Buffer.from(raw, 'base64');
+  if (bytes.length !== 32) {
+    throw new ApplicationError(
+      'Set MEETINGS_TOKEN_ENCRYPTION_KEY to 32 random bytes (for example `openssl rand -hex 32`) to connect Google Calendars.',
+      503,
+      'MEETINGS_CALENDAR_NOT_CONFIGURED',
+    );
+  }
+  return bytes;
+}
+
+function owner(organizationId: string, userId: string): Buffer {
+  return Buffer.from(`tapcrm-calendar-v1:${organizationId}:${userId}`);
+}
+
+export function sealSecret(value: string, organizationId: string, userId: string): string {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv('aes-256-gcm', key(), iv);
+  cipher.setAAD(owner(organizationId, userId));
+  const body = Buffer.concat([cipher.update(value, 'utf8'), cipher.final()]);
+  return ['v1', iv.toString('base64url'), cipher.getAuthTag().toString('base64url'), body.toString('base64url')].join('.');
+}
+
+export function openSecret(sealed: string, organizationId: string, userId: string): string {
+  const [version, iv, tag, body] = sealed.split('.');
+  if (version !== 'v1' || !iv || !tag || !body) throw new Error('Unreadable calendar credential');
+  const decipher = createDecipheriv('aes-256-gcm', key(), Buffer.from(iv, 'base64url'));
+  decipher.setAAD(owner(organizationId, userId));
+  decipher.setAuthTag(Buffer.from(tag, 'base64url'));
+  return Buffer.concat([decipher.update(Buffer.from(body, 'base64url')), decipher.final()]).toString('utf8');
+}
+
+export function hashState(state: string): string {
+  return createHash('sha256').update(state).digest('base64url');
+}
+
+export function sameHash(left: string, right: string): boolean {
+  const a = Buffer.from(left);
+  const b = Buffer.from(right);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
