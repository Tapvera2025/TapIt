--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/availability.test.ts
@@ -0,0 +1,115 @@
+import { describe, expect, it } from 'vitest';
+import type { DateOnly, ResolvedDay, ResolvedShift } from '@tapcrm/contracts';
+import {
+  alignUp,
+  intersectIntervals,
+  leaveOn,
+  mergeIntervals,
+  slotStarts,
+  subtractIntervals,
+  workingWindow,
+  type Interval,
+} from './availability.js';
+import { clientReminderDue } from './automation.js';
+
+const at = (iso: string) => new Date(iso).getTime();
+const span = (from: string, to: string): Interval => ({ start: at(from), end: at(to) });
+const iso = (intervals: Interval[]) => intervals.map((item) => [new Date(item.start).toISOString(), new Date(item.end).toISOString()]);
+
+describe('interval arithmetic', () => {
+  it('merges overlapping and touching intervals', () => {
+    expect(iso(mergeIntervals([span('2026-11-10T05:00Z', '2026-11-10T06:00Z'), span('2026-11-10T06:00Z', '2026-11-10T07:00Z'), span('2026-11-10T04:00Z', '2026-11-10T04:30Z')])))
+      .toEqual([['2026-11-10T04:00:00.000Z', '2026-11-10T04:30:00.000Z'], ['2026-11-10T05:00:00.000Z', '2026-11-10T07:00:00.000Z']]);
+  });
+
+  it('takes busy time out of free time', () => {
+    const free = [span('2026-11-10T04:30Z', '2026-11-10T12:30Z')];
+    const busy = [span('2026-11-10T05:30Z', '2026-11-10T06:30Z'), span('2026-11-10T12:00Z', '2026-11-10T13:00Z')];
+    expect(iso(subtractIntervals(free, busy))).toEqual([
+      ['2026-11-10T04:30:00.000Z', '2026-11-10T05:30:00.000Z'],
+      ['2026-11-10T06:30:00.000Z', '2026-11-10T12:00:00.000Z'],
+    ]);
+  });
+
+  it('keeps only the time everyone has free', () => {
+    const mine = [span('2026-11-10T04:30Z', '2026-11-10T08:00Z')];
+    const yours = [span('2026-11-10T06:00Z', '2026-11-10T12:30Z')];
+    expect(iso(intersectIntervals(mine, yours))).toEqual([['2026-11-10T06:00:00.000Z', '2026-11-10T08:00:00.000Z']]);
+  });
+});
+
+describe('slots', () => {
+  it('starts slots on the hour and half hour of the local clock', () => {
+    // 10:07 IST rounds up to 10:30 IST (05:00Z).
+    expect(new Date(alignUp(at('2026-11-10T04:37Z'), 30, 'Asia/Kolkata')).toISOString()).toBe('2026-11-10T05:00:00.000Z');
+    // Kathmandu is UTC+5:45: its half hours are :15 and :45 past in UTC.
+    expect(new Date(alignUp(at('2026-11-10T04:20Z'), 30, 'Asia/Kathmandu')).toISOString()).toBe('2026-11-10T04:45:00.000Z');
+  });
+
+  it('fits whole meetings into the free time', () => {
+    const free = [span('2026-11-10T04:30Z', '2026-11-10T06:00Z')];
+    const starts = slotStarts(free, 45, 30, 'Asia/Kolkata', at('2026-11-10T00:00Z'), at('2026-11-11T00:00Z')).map((value) => new Date(value).toISOString());
+    expect(starts).toEqual(['2026-11-10T04:30:00.000Z', '2026-11-10T05:00:00.000Z']);
+  });
+
+  it('offers nothing before the earliest allowed time', () => {
+    const free = [span('2026-11-10T04:30Z', '2026-11-10T07:00Z')];
+    const starts = slotStarts(free, 30, 30, 'Asia/Kolkata', at('2026-11-10T05:10Z'), at('2026-11-11T00:00Z'));
+    expect(new Date(starts[0]!).toISOString()).toBe('2026-11-10T05:30:00.000Z');
+  });
+});
+
+describe('working time', () => {
+  const date = '2026-11-10' as DateOnly;
+  const day = (type: ResolvedDay['type']): ResolvedDay => ({ date, type, holidayId: null, holidayName: null, subtype: null, matchedBy: null });
+  const shift = (overrides: Partial<ResolvedShift>): ResolvedShift => ({
+    date, source: 'default' as ResolvedShift['source'], shiftId: null, versionId: null, kind: 'fixed', start: '09:30' as ResolvedShift['start'], end: '18:30' as ResolvedShift['end'],
+    isOvernight: false, graceMinutes: 0, earlyExitGraceMinutes: 0, fullDayMinutes: 540, halfDayMinutes: 270, complementaryHalfMinutes: null,
+    minOvertimeMinutes: null, earlyWindowMinutes: 0, maxClosingExtensionMinutes: null, timezone: 'Asia/Kolkata', ...overrides,
+  });
+
+  it('uses the fixed shift on a working day', () => {
+    expect(iso([workingWindow(day('working'), shift({}), [], 'Asia/Kolkata')!])).toEqual([['2026-11-10T04:00:00.000Z', '2026-11-10T13:00:00.000Z']]);
+  });
+
+  it('counts a flexible shift, or none, as 10:00–18:00', () => {
+    expect(iso([workingWindow(day('working'), shift({ kind: 'flexible', start: null, end: null }), [], 'Asia/Kolkata')!]))
+      .toEqual([['2026-11-10T04:30:00.000Z', '2026-11-10T12:30:00.000Z']]);
+  });
+
+  it('has no time on holidays, week-offs and full days of leave', () => {
+    expect(workingWindow(day('holiday'), shift({}), [], 'Asia/Kolkata')).toBeNull();
+    expect(workingWindow(day('week-off'), shift({}), [], 'Asia/Kolkata')).toBeNull();
+    expect(workingWindow(day('working'), shift({}), [{ fromDate: date, toDate: date, fromHalf: 'full', toHalf: 'full' }], 'Asia/Kolkata')).toBeNull();
+  });
+
+  it('keeps the other half of a half day of leave', () => {
+    const firstHalfOff = workingWindow(day('working'), shift({}), [{ fromDate: date, toDate: date, fromHalf: 'first', toHalf: 'first' }], 'Asia/Kolkata')!;
+    expect(iso([firstHalfOff])).toEqual([['2026-11-10T08:30:00.000Z', '2026-11-10T13:00:00.000Z']]);
+  });
+
+  it('reads which part of each day a leave takes', () => {
+    const leave = { fromDate: '2026-11-09' as DateOnly, toDate: '2026-11-11' as DateOnly, fromHalf: 'second' as const, toHalf: 'first' as const };
+    expect(leaveOn('2026-11-09' as DateOnly, leave)).toBe('second');
+    expect(leaveOn('2026-11-10' as DateOnly, leave)).toBe('full');
+    expect(leaveOn('2026-11-11' as DateOnly, leave)).toBe('first');
+    expect(leaveOn('2026-11-12' as DateOnly, leave)).toBeNull();
+  });
+});
+
+describe('client reminders', () => {
+  const startsAt = new Date('2026-11-12T09:30:00Z');
+  const longAgo = new Date('2026-11-01T00:00:00Z');
+  it('sends the day-before reminder, then the hour-before one', () => {
+    expect(clientReminderDue(startsAt, longAgo, new Date('2026-11-11T08:00:00Z'))).toBeNull();
+    expect(clientReminderDue(startsAt, longAgo, new Date('2026-11-11T09:31:00Z'))).toBe('client_24h');
+    expect(clientReminderDue(startsAt, longAgo, new Date('2026-11-12T08:31:00Z'))).toBe('client_1h');
+    expect(clientReminderDue(startsAt, longAgo, new Date('2026-11-12T09:31:00Z'))).toBeNull();
+  });
+
+  it('skips the day-before reminder for a meeting confirmed the same day', () => {
+    const confirmed = new Date('2026-11-12T04:00:00Z');
+    expect(clientReminderDue(startsAt, confirmed, new Date('2026-11-12T05:00:00Z'))).toBeNull();
+    expect(clientReminderDue(startsAt, confirmed, new Date('2026-11-12T08:35:00Z'))).toBe('client_1h');
+  });
+});
diff --git a/tapcrm/packages/server/src/modules/meetings/availability.ts b/tapcrm/packages/server/src/modules/meetings/availability.ts
new file mode 100644
index 0000000..7474ed2
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/availability.ts
@@ -0,0 +1,316 @@
+import type { DateOnly, ResolvedDay, ResolvedShift } from '@tapcrm/contracts';
+import type { RequestContext } from '../../platform/dal/context.js';
+import { db, type Tx } from '../../platform/dal/db.js';
+import { sql } from '../../platform/dal/sql.js';
+import { addDays, instantAt, localDateOf, toLocalTime, utcOffsetMinutes } from '../../platform/time.js';
+import { dayTypeRange } from '../holidays/facade.js';
+import { resolveRange } from '../shifts/facade.js';
+import { calendarAccess, markNeedsReconnect, type CalendarAccess } from './google/access.js';
+import { CalendarAuthError, freeBusy } from './google/calendar.js';
+import type { AvailabilityResult, MeetingSlot } from './types.js';
+
+/**
+ * When people are free to meet.
+ *
+ *   working time   their shift on each working day (holidays and week-offs
+ *                  are off); a flexible shift, or none, counts as 10:00–18:00
+ *   minus          approved leave (a half day takes half the day), their open
+ *                  meetings and offered times, their pending callbacks, and
+ *                  busy times on their Google Calendar when TapCRM can read it
+ *
+ * Slots start on the hour or half hour in the organization's time zone.
+ */
+
+export interface Interval {
+  readonly start: number;
+  readonly end: number;
+}
+
+const MINUTE = 60_000;
+const DEFAULT_DAY_START = toLocalTime('10:00');
+const DEFAULT_DAY_END = toLocalTime('18:00');
+/** A callback blocks this long. */
+const CALLBACK_MINUTES = 15;
+
+/* ------------------------------------------------------------------ *
+ * Interval arithmetic (pure)
+ * ------------------------------------------------------------------ */
+
+export function mergeIntervals(list: readonly Interval[]): Interval[] {
+  const sorted = list.filter((item) => item.end > item.start).sort((a, b) => a.start - b.start);
+  const merged: Interval[] = [];
+  for (const item of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && item.start <= last.end) merged[merged.length - 1] = { start: last.start, end: Math.max(last.end, item.end) };
+    else merged.push({ ...item });
+  }
+  return merged;
+}
+
+export function subtractIntervals(free: readonly Interval[], busy: readonly Interval[]): Interval[] {
+  const blocks = mergeIntervals(busy);
+  const out: Interval[] = [];
+  for (const window of mergeIntervals(free)) {
+    let cursor = window.start;
+    for (const block of blocks) {
+      if (block.end <= cursor || block.start >= window.end) continue;
+      if (block.start > cursor) out.push({ start: cursor, end: Math.min(block.start, window.end) });
+      cursor = Math.max(cursor, block.end);
+      if (cursor >= window.end) break;
+    }
+    if (cursor < window.end) out.push({ start: cursor, end: window.end });
+  }
+  return out;
+}
+
+export function intersectIntervals(left: readonly Interval[], right: readonly Interval[]): Interval[] {
+  const a = mergeIntervals(left);
+  const b = mergeIntervals(right);
+  const out: Interval[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    const start = Math.max(a[i]!.start, b[j]!.start);
+    const end = Math.min(a[i]!.end, b[j]!.end);
+    if (end > start) out.push({ start, end });
+    if (a[i]!.end < b[j]!.end) i += 1;
+    else j += 1;
+  }
+  return out;
+}
+
+/** The next instant at or after `at` that falls on a step boundary of the zone's clock. */
+export function alignUp(at: number, stepMinutes: number, zone: string): number {
+  const offset = utcOffsetMinutes(zone, new Date(at)) * MINUTE;
+  const step = stepMinutes * MINUTE;
+  return Math.ceil((at + offset) / step) * step - offset;
+}
+
+/** Start times of every `durationMinutes` meeting that fits in `free`. */
+export function slotStarts(
+  free: readonly Interval[],
+  durationMinutes: number,
+  stepMinutes: number,
+  zone: string,
+  earliest: number,
+  latest: number,
+): number[] {
+  const starts: number[] = [];
+  const duration = durationMinutes * MINUTE;
+  for (const window of mergeIntervals(free)) {
+    for (let at = alignUp(Math.max(window.start, earliest), stepMinutes, zone); at + duration <= window.end && at <= latest; at += stepMinutes * MINUTE) {
+      starts.push(at);
+    }
+  }
+  return starts;
+}
+
+export type LeaveHalf = 'full' | 'first' | 'second';
+
+export interface LeaveSpan {
+  readonly fromDate: DateOnly;
+  readonly toDate: DateOnly;
+  readonly fromHalf: LeaveHalf;
+  readonly toHalf: LeaveHalf;
+}
+
+/** Which part of `date` an approved leave takes, if any. */
+export function leaveOn(date: DateOnly, leave: LeaveSpan): LeaveHalf | null {
+  if (date < leave.fromDate || date > leave.toDate) return null;
+  if (leave.fromDate === leave.toDate) {
+    if (leave.fromHalf === 'full' || leave.toHalf === 'full') return 'full';
+    return leave.fromHalf === leave.toHalf ? leave.fromHalf : 'full';
+  }
+  if (date === leave.fromDate && leave.fromHalf === 'second') return 'second';
+  if (date === leave.toDate && leave.toHalf === 'first') return 'first';
+  return 'full';
+}
+
+/** The day's working window, or none on a day off. */
+export function workingWindow(
+  day: ResolvedDay,
+  shift: ResolvedShift,
+  leaves: readonly LeaveSpan[],
+  organizationZone: string,
+): Interval | null {
+  if (day.type !== 'working') return null;
+  const parts = leaves.map((leave) => leaveOn(day.date, leave)).filter((part): part is LeaveHalf => part !== null);
+  if (parts.includes('full') || (parts.includes('first') && parts.includes('second'))) return null;
+  let start: number;
+  let end: number;
+  if (shift.kind === 'fixed' && shift.start && shift.end) {
+    start = instantAt(day.date, shift.start, shift.timezone).getTime();
+    end = instantAt(shift.isOvernight ? addDays(day.date, 1) : day.date, shift.end, shift.timezone).getTime();
+  } else {
+    start = instantAt(day.date, DEFAULT_DAY_START, organizationZone).getTime();
+    end = instantAt(day.date, DEFAULT_DAY_END, organizationZone).getTime();
+  }
+  if (end <= start) return null;
+  const middle = start + Math.floor((end - start) / 2 / MINUTE) * MINUTE;
+  if (parts.includes('first')) start = middle;
+  if (parts.includes('second')) end = middle;
+  return { start, end };
+}
+
+/* ------------------------------------------------------------------ *
+ * Loading one person's time
+ * ------------------------------------------------------------------ */
+
+export async function organizationTimezone(tx: Tx, organizationId: string): Promise<string> {
+  const row = await tx.maybeOne<{ timezone: string | null }>(sql`SELECT timezone FROM organization WHERE id = ${organizationId}`);
+  return row?.timezone ?? 'Asia/Kolkata';
+}
+
+/** Working time minus everything TapCRM knows about; Google is added separately. */
+export async function tapcrmFreeTime(
+  tx: Tx,
+  organizationId: string,
+  userId: string,
+  from: Date,
+  to: Date,
+  zone: string,
+  excludeMeetingId: string | null,
+): Promise<Interval[]> {
+  const fromDate = addDays(localDateOf(from, zone), -1);
+  const toDate = localDateOf(to, zone);
+  const [shifts, days, leaves, busy] = await Promise.all([
+    resolveRange(tx, userId, fromDate, toDate),
+    dayTypeRange(tx, userId, fromDate, toDate),
+    tx.query<LeaveSpan>(sql`
+      SELECT from_date::text AS "fromDate", to_date::text AS "toDate", from_half AS "fromHalf", to_half AS "toHalf"
+        FROM leave_request
+       WHERE organization_id = ${organizationId} AND user_id = ${userId}
+         AND kind = 'absence' AND status = 'approved'
+         AND from_date <= ${toDate}::date AND to_date >= ${fromDate}::date
+    `),
+    tx.query<{ startsAt: Date; endsAt: Date }>(sql`
+      SELECT m.starts_at AS "startsAt", m.ends_at AS "endsAt"
+        FROM meeting m
+       WHERE m.organization_id = ${organizationId}
+         AND (m.status IN ('requested', 'confirmed') OR (m.status = 'proposed' AND m.calendar_event_id IS NOT NULL))
+         AND m.starts_at < ${to} AND m.ends_at > ${from}
+         AND (${excludeMeetingId}::uuid IS NULL OR m.id <> ${excludeMeetingId}::uuid)
+         AND (m.host_id = ${userId} OR EXISTS (
+               SELECT 1 FROM meeting_attendee a
+                WHERE a.organization_id = m.organization_id AND a.meeting_id = m.id
+                  AND a.user_id = ${userId} AND a.role IN ('host', 'staff')))
+      UNION ALL
+      SELECT p.starts_at, p.ends_at
+        FROM meeting_proposal p
+        JOIN meeting m ON m.organization_id = p.organization_id AND m.id = p.meeting_id
+       WHERE p.organization_id = ${organizationId} AND m.status = 'proposed'
+         AND p.chosen_at IS NULL AND p.withdrawn_at IS NULL
+         AND p.starts_at < ${to} AND p.ends_at > ${from}
+         AND (${excludeMeetingId}::uuid IS NULL OR m.id <> ${excludeMeetingId}::uuid)
+         AND m.host_id = ${userId}
+      UNION ALL
+      SELECT c.scheduled_at, c.scheduled_at + make_interval(mins => ${CALLBACK_MINUTES})
+        FROM lead_callback c
+       WHERE c.organization_id = ${organizationId} AND c.owner_id = ${userId} AND c.status = 'pending'
+         AND c.scheduled_at < ${to} AND c.scheduled_at + make_interval(mins => ${CALLBACK_MINUTES}) > ${from}
+    `),
+  ]);
+  const byDate = new Map(shifts.map((shift) => [shift.date, shift]));
+  const windows: Interval[] = [];
+  for (const day of days) {
+    const shift = byDate.get(day.date);
+    if (!shift) continue;
+    const window = workingWindow(day, shift, leaves, zone);
+    if (window) windows.push(window);
+  }
+  const range = { start: from.getTime(), end: to.getTime() };
+  return subtractIntervals(
+    intersectIntervals(windows, [range]),
+    busy.map((item) => ({ start: new Date(item.startsAt).getTime(), end: new Date(item.endsAt).getTime() })),
+  );
+}
+
+/** Busy times on the person's Google Calendar, or why they could not be read. */
+export async function googleBusy(
+  ctx: RequestContext,
+  userId: string,
+  from: Date,
+  to: Date,
+): Promise<{ busy: Interval[]; unchecked: string | null }> {
+  const access: CalendarAccess = await calendarAccess(ctx, userId);
+  if (access.token === null) {
+    if (access.reason === 'off') return { busy: [], unchecked: null };
+    return {
+      busy: [],
+      unchecked: access.reason === 'not_connected'
+        ? 'Google Calendar not connected'
+        : access.reason === 'needs_reconnect'
+          ? 'Google Calendar needs reconnecting'
+          : 'Google Calendar could not be read',
+    };
+  }
+  try {
+    const busy = await freeBusy(access.token, from, to);
+    return { busy: busy.map((item) => ({ start: item.start.getTime(), end: item.end.getTime() })), unchecked: null };
+  } catch (cause) {
+    if (cause instanceof CalendarAuthError) await markNeedsReconnect(ctx, userId, cause.message);
+    return { busy: [], unchecked: 'Google Calendar could not be read' };
+  }
+}
+
+export interface AvailabilityQuery {
+  /** Everyone who has to be free (all of them), or candidates (any one of them). */
+  readonly userIds: readonly string[];
+  readonly mode: 'all' | 'any';
+  readonly durationMinutes: number;
+  readonly from: Date;
+  readonly to: Date;
+  readonly excludeMeetingId?: string | null;
+  readonly stepMinutes?: number;
+  readonly limit?: number;
+}
+
+/** Free slots for a group (`all`) or for whichever candidate is free (`any`). */
+export async function findSlots(ctx: RequestContext, query: AvailabilityQuery): Promise<AvailabilityResult> {
+  const people = await db.query<{ id: string; name: string }>(ctx, sql`
+    SELECT id, full_name AS name FROM app_user
+     WHERE organization_id = ${ctx.organizationId} AND id = ANY(${[...query.userIds]}::uuid[]) AND status = 'active'
+  `);
+  const { zone, local } = await db.transaction(ctx, async (tx) => {
+    const zoneName = await organizationTimezone(tx, ctx.organizationId);
+    const perPerson = new Map<string, Interval[]>();
+    for (const person of people) {
+      perPerson.set(person.id, await tapcrmFreeTime(tx, ctx.organizationId, person.id, query.from, query.to, zoneName, query.excludeMeetingId ?? null));
+    }
+    return { zone: zoneName, local: perPerson };
+  });
+  const calendarUnchecked: Array<{ id: string; name: string; reason: string }> = [];
+  const free = new Map<string, Interval[]>();
+  await Promise.all(people.map(async (person) => {
+    const google = await googleBusy(ctx, person.id, query.from, query.to);
+    if (google.unchecked) calendarUnchecked.push({ id: person.id, name: person.name, reason: google.unchecked });
+    free.set(person.id, subtractIntervals(local.get(person.id) ?? [], google.busy));
+  }));
+
+  const step = query.stepMinutes ?? 30;
+  const earliest = query.from.getTime();
+  const latest = query.to.getTime();
+  const limit = query.limit ?? 400;
+  const slots: MeetingSlot[] = [];
+  if (query.mode === 'all') {
+    if (people.length !== query.userIds.length) return { slots: [], calendarUnchecked, timezone: zone };
+    const shared = people.reduce<Interval[] | null>((acc, person) => {
+      const mine = free.get(person.id) ?? [];
+      return acc === null ? mine : intersectIntervals(acc, mine);
+    }, null) ?? [];
+    for (const start of slotStarts(shared, query.durationMinutes, step, zone, earliest, latest).slice(0, limit)) {
+      slots.push({ startsAt: new Date(start), endsAt: new Date(start + query.durationMinutes * MINUTE), hostIds: people.map((person) => person.id) });
+    }
+  } else {
+    const byStart = new Map<number, string[]>();
+    for (const person of people) {
+      for (const start of slotStarts(free.get(person.id) ?? [], query.durationMinutes, step, zone, earliest, latest)) {
+        byStart.set(start, [...(byStart.get(start) ?? []), person.id]);
+      }
+    }
+    for (const start of [...byStart.keys()].sort((a, b) => a - b).slice(0, limit)) {
+      slots.push({ startsAt: new Date(start), endsAt: new Date(start + query.durationMinutes * MINUTE), hostIds: byStart.get(start)! });
+    }
+  }
+  return { slots, calendarUnchecked, timezone: zone };
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/calendar-sync.ts b/tapcrm/packages/server/src/modules/meetings/calendar-sync.ts
new file mode 100644
index 0000000..0f21177
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/calendar-sync.ts
@@ -0,0 +1,134 @@
+import { randomUUID } from 'node:crypto';
+import type { RequestContext } from '../../platform/dal/context.js';
+import { db } from '../../platform/dal/db.js';
+import { sql } from '../../platform/dal/sql.js';
+import { organizationTimezone } from './availability.js';
+import { calendarAccess, markNeedsReconnect } from './google/access.js';
+import { CalendarAuthError, addGuest, deleteEvent, insertEvent, moveEvent } from './google/calendar.js';
+import { tellStaff } from './messages.js';
+import { findMeeting, insertMeetingEvent, type MeetingRecord } from './repository.js';
+
+/**
+ * Keeps a confirmed meeting's Google Calendar event in step with TapCRM.
+ * Runs after the meeting change commits: Google is slow and can fail, and the
+ * meeting stands either way. A failure is recorded on the meeting and the host
+ * is told, so they can reconnect or paste a link.
+ */
+
+function describe(row: MeetingRecord): string {
+  return [
+    row.agenda ?? '',
+    row.projectName ? `Project: ${row.projectName}` : '',
+    row.clientBusiness ? `Client: ${row.clientBusiness}` : '',
+    'Booked through TapCRM.',
+  ].filter(Boolean).join('\n\n');
+}
+
+async function recordFailure(ctx: RequestContext, row: MeetingRecord, message: string): Promise<void> {
+  await db.transaction(ctx, async (tx) => {
+    await tx.query(sql`UPDATE meeting SET calendar_error = ${message.slice(0, 500)} WHERE organization_id = ${ctx.organizationId} AND id = ${row.id}`);
+    await insertMeetingEvent(tx, ctx.organizationId, row.id, 'calendar_failed', { id: null, kind: 'system' }, { message: message.slice(0, 300) });
+    await tellStaff(tx, ctx, [row.hostId], {
+      type: 'meeting.calendar_failed',
+      title: 'Google Calendar did not take the meeting',
+      body: `${message} Open the meeting to add a link yourself, or reconnect Google Calendar.`,
+      meetingId: row.id,
+      urgent: true,
+      includeActor: true,
+    });
+  });
+}
+
+/** Creates the event with a Meet link on the host's calendar. Returns the link, if any. */
+export async function putOnCalendar(ctx: RequestContext, meetingId: string): Promise<string | null> {
+  const row = await findMeeting(ctx, meetingId);
+  if (!row || row.status !== 'confirmed') return row?.meetUrl ?? null;
+  if (row.calendarEventId) return row.meetUrl;
+  const access = await calendarAccess(ctx, row.hostId);
+  if (access.token === null) {
+    if (access.reason === 'off') return row.meetUrl;
+    if (!row.meetUrl) {
+      await recordFailure(ctx, row, access.reason === 'not_connected'
+        ? `${row.hostName} has not connected Google Calendar, so no Meet link was made.`
+        : `${row.hostName}'s Google Calendar needs reconnecting, so no Meet link was made.`);
+    }
+    return row.meetUrl;
+  }
+  const zone = await db.transaction(ctx, (tx) => organizationTimezone(tx, ctx.organizationId));
+  try {
+    const guests = row.attendees
+      .filter((attendee) => attendee.email && attendee.userId !== row.hostId)
+      .map((attendee) => ({ email: attendee.email!, name: attendee.name }));
+    const event = await insertEvent(access.token, {
+      summary: row.title,
+      description: describe(row),
+      start: new Date(row.startsAt),
+      end: new Date(row.endsAt),
+      timeZone: zone,
+      guests,
+      requestId: randomUUID(),
+    });
+    await db.transaction(ctx, (tx) => tx.query(sql`
+      UPDATE meeting
+         SET calendar_event_id = ${event.eventId}, calendar_owner_id = ${row.hostId},
+             meet_url = COALESCE(${event.meetUrl}, meet_url), calendar_error = NULL
+       WHERE organization_id = ${ctx.organizationId} AND id = ${row.id}
+    `));
+    return event.meetUrl ?? row.meetUrl;
+  } catch (cause) {
+    const message = cause instanceof Error ? cause.message : String(cause);
+    if (cause instanceof CalendarAuthError) await markNeedsReconnect(ctx, row.hostId, message);
+    await recordFailure(ctx, row, `Google Calendar refused the event (${message}).`);
+    return row.meetUrl;
+  }
+}
+
+/** Moves the event to the meeting's current time, or creates it when there is none yet. */
+export async function moveOnCalendar(ctx: RequestContext, meetingId: string): Promise<string | null> {
+  const row = await findMeeting(ctx, meetingId);
+  if (!row || row.status !== 'confirmed') return null;
+  if (!row.calendarEventId || !row.calendarOwnerId) return putOnCalendar(ctx, meetingId);
+  const access = await calendarAccess(ctx, row.calendarOwnerId);
+  if (access.token === null) {
+    await recordFailure(ctx, row, 'The Google Calendar event could not be moved; update it by hand.');
+    return row.meetUrl;
+  }
+  try {
+    const zone = await db.transaction(ctx, (tx) => organizationTimezone(tx, ctx.organizationId));
+    await moveEvent(access.token, row.calendarEventId, new Date(row.startsAt), new Date(row.endsAt), zone);
+  } catch (cause) {
+    const message = cause instanceof Error ? cause.message : String(cause);
+    if (cause instanceof CalendarAuthError) await markNeedsReconnect(ctx, row.calendarOwnerId, message);
+    await recordFailure(ctx, row, `The Google Calendar event could not be moved (${message}).`);
+  }
+  return row.meetUrl;
+}
+
+/** Cancels the event; Google tells the guests. */
+export async function takeOffCalendar(ctx: RequestContext, row: Pick<MeetingRecord, 'id' | 'calendarEventId' | 'calendarOwnerId'>): Promise<void> {
+  if (!row.calendarEventId || !row.calendarOwnerId) return;
+  const access = await calendarAccess(ctx, row.calendarOwnerId);
+  if (access.token === null) return;
+  try {
+    await deleteEvent(access.token, row.calendarEventId);
+  } catch (cause) {
+    if (cause instanceof CalendarAuthError) await markNeedsReconnect(ctx, row.calendarOwnerId, cause.message);
+    console.error('[meetings] calendar event not cancelled', row.id, cause instanceof Error ? cause.message : cause);
+  }
+}
+
+/** Adds someone joining uninvited to the event, so Meet lets them straight in. */
+export async function addToCalendarEvent(
+  ctx: RequestContext,
+  row: Pick<MeetingRecord, 'id' | 'calendarEventId' | 'calendarOwnerId'>,
+  guest: { email: string; name: string },
+): Promise<void> {
+  if (!row.calendarEventId || !row.calendarOwnerId) return;
+  const access = await calendarAccess(ctx, row.calendarOwnerId);
+  if (access.token === null) return;
+  try {
+    await addGuest(access.token, row.calendarEventId, guest);
+  } catch (cause) {
+    console.error('[meetings] could not add guest', row.id, cause instanceof Error ? cause.message : cause);
+  }
+}
diff --git a/tapcrm/packages/server/src/modules/meetings/google/access.ts b/tapcrm/packages/server/src/modules/meetings/google/access.ts
new file mode 100644
index 0000000..eba4ed9
--- /dev/null
+++ b/tapcrm/packages/server/src/modules/meetings/google/access.ts
@@ -0,0 +1,89 @@
+import { loadConfig } from '../../../config.js';
+import type { RequestContext } from '../../../platform/dal/context.js';
+import { db } from '../../../platform/dal/db.js';
+import { sql } from '../../../platform/dal/sql.js';
+import {
+  GoogleAuthUnavailableError,
+  googleDelegatedAccessToken,
+  googleRefreshedAccessToken,
+} from '../../../platform/integrations/google/token.js';
+import { CALENDAR_SCOPES } from './calendar.js';
+import { openSecret } from './crypto.js';
+
+/**
+ * Whose Google Calendar TapCRM may use, and a token for it.
+ *
+ *   off              no calendar: hosts paste a meeting link
+ *   oauth            the person's own connection (calendar_connection)
+ *   service-account  Workspace delegation, acting as the person's email
+ */
+export type CalendarMode = 'off' | 'oauth' | 'service-account';
+
+export function calendarMode(): CalendarMode {
+  return loadConfig().MEETINGS_GOOGLE_AUTH;
+}
+
+export type CalendarAccess =
+  | { readonly token: string }
+  | {
+      readonly token: null;
+      readonly reason: 'off' | 'not_connected' | 'needs_reconnect' | 'error';
+      readonly message?: string;
+    };
+
+type Ctx = RequestContext;
+
+/** Access tokens from refresh tokens, per person, until shortly before they expire. */
+const cached = new Map<string, { token: string; expiresAt: number }>();
+
+export function forgetCalendarToken(organizationId: string, userId: string): void {
+  cached.delete(`${organizationId}:${userId}`);
+}
+
+export async function markNeedsReconnect(ctx: Ctx, userId: string, message: string): Promise<void> {
+  forgetCalendarToken(ctx.organizationId, userId);
+  await db.query(ctx, sql`
+    UPDATE calendar_connection SET status = 'needs_reconnect', last_error = ${message.slice(0, 500)}
+     WHERE organization_id = ${ctx.organizationId} AND user_id = ${userId}
+  `);
+}
+
+export async function calendarAccess(ctx: Ctx, userId: string): Promise<CalendarAccess> {
+  const mode = calendarMode();
+  if (mode === 'off') return { token: null, reason: 'off' };
+
+  if (mode === 'service-account') {
+    const person = await db.maybeOne<{ email: string | null }>(ctx, sql`
+      SELECT email::text AS email FROM app_user WHERE organization_id = ${ctx.organizationId} AND id = ${userId}
+    `);
+    if (!person?.email) return { token: null, reason: 'not_connected', message: 'This person has no email address in TapCRM.' };
+    try {
+      return { token: await googleDelegatedAccessToken(CALENDAR_SCOPES, person.email) };
+    } catch (cause) {
+      return { token: null, reason: 'error', message: cause instanceof Error ? cause.message : String(cause) };
+    }
+  }
+
+  const key = `${ctx.organizationId}:${userId}`;
+  const hit = cached.get(key);
+  if (hit && hit.expiresAt - 60_000 > Date.now()) return { token: hit.token };
+  const connection = await db.maybeOne<{ sealed: string; status: string }>(ctx, sql`
+    SELECT credentials_encrypted AS sealed, status FROM calendar_connection
+     WHERE organization_id = ${ctx.organizationId} AND user_id = ${userId} AND provider = 'google'
+  `);
+  if (!connection) return { token: null, reason: 'not_connected' };
+  if (connection.status !== 'active') return { token: null, reason: 'needs_reconnect' };
+  try {
+    const refreshToken = openSecret(connection.sealed, ctx.organizationId, userId);
+    const fresh = await googleRefreshedAccessToken(refreshToken);
+    cached.set(key, fresh);
+    return { token: fresh.token };
+  } catch (cause) {
+    const message = cause instanceof Error ? cause.message : String(cause);
+    if (cause instanceof GoogleAuthUnavailableError) {
+      await markNeedsReconnect(ctx, userId, message);
+      return { token: null, reason: 'needs_reconnect', message };
+    }
+    return { token: null, reason: 'error', message };
+  }
+}
