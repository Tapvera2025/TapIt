+          </div>
+          {!googleMakesLinks && (
+            <Field label="Meeting link (optional)" value={link} onChange={setLink} placeholder="https://meet.google.com/…" hint="Connect Google Calendar to get a Meet link automatically." />
+          )}
+        </div>
+      )}
+    </Modal>
