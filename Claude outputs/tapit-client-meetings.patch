+}
+
+function CalendarPanel({ connection, onConnect, onDisconnect }: {
+  connection: CalendarConnection | null;
+  onConnect: () => void;
+  onDisconnect: () => void;
+}): React.JSX.Element {
+  if (connection === null) return <Loading />;
