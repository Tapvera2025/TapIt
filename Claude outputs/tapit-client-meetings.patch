+
+function MeetingActionDialog({ dialog, calendar, timeZone, onClose, onRun }: {
+  dialog: Exclude<Dialog, { kind: 'book' } | null>;
+  calendar: CalendarConnection | null;
+  timeZone: string;
+  onClose: () => void;
