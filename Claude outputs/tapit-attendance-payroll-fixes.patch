+  const rows = await tx.query<{ advanceDeductionId: string | null; penaltyId: string | null }>(sql`
+    SELECT DISTINCT i.advance_deduction_id AS "advanceDeductionId", i.penalty_id AS "penaltyId"
+    FROM payslip p
