# TapCRM environment template.
#
# TECH.md DP-3: secrets come from a managed secret store, never source files.
# This file documents the shape only. Copy it to .env and fill it in; never
# commit a filled-in .env.
#
# Generate a secret:   openssl rand -hex 32
#
# Docker Compose reads .env automatically. Every secret below is REQUIRED by
# `docker compose` (no fallback), so a missing one stops it with a message.
# The API itself reads process.env only and does not load this file: to run it
# on the host, export the values first:  set -a; source .env; set +a

NODE_ENV=development
LOG_LEVEL=debug

# Leave unset to exercise real Identity authentication. Set true only for local
# authorization-pipeline testing with x-dev-* headers. Refused when
# NODE_ENV=production. Booleans accept true/false/1/0/yes/no/on/off.
# IDENTITY_DEV_BYPASS=false

# Local development only. With true, "Forgot password?" on the company login
# page gives a company admin (super-admin) account a new password on screen
# instead of an emailed link, and signs that account out everywhere else.
# Employees still get the emailed link. Only answers requests made on this
# machine, and the API refuses to start with it when NODE_ENV=production.
# Restart the API after changing it.
# DEV_INSTANT_PASSWORD_RESET=false

# ---------------------------------------------------------------------------
# PostgreSQL (TECH.md PG-1: 18.x; PG-3: runtime role never has BYPASSRLS)
# ---------------------------------------------------------------------------
# Compose stack: these build both database URLs inside the containers.
POSTGRES_DB=tapcrm
POSTGRES_MIGRATOR_USER=tapcrm_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-me-generate-with-openssl
# The runtime role tapcrm_app. Set by `npm run db:app-password` after migrating
# (compose does this on every start); it is never written in a migration.
POSTGRES_APP_PASSWORD=replace-me-generate-with-openssl
# Host port the compose Postgres is published on (127.0.0.1 only).
POSTGRES_HOST_PORT=5432

# API on the host (not in compose): keep the passwords and port in step with the
# values above.
# The APPLICATION role. Owns no tables, cannot bypass RLS, has no UPDATE or
# DELETE on append-only tables. The only role the request path uses.
DATABASE_URL=postgres://tapcrm_app:replace-me@localhost:5432/tapcrm
# The MIGRATION/ADMIN role. Owns the tables. Used by migrations and seeds only,
# never by a serving process (TECH.md 4.2.1). Compose does not give it to the API.
MIGRATION_DATABASE_URL=postgres://tapcrm_migrator:replace-me@localhost:5432/tapcrm

# DP-8: pool size is budgeted, not guessed.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis (TECH.md 2.3 - session versions, permission sets, socket fan-out, queues)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379
# Where brute-force counters live. Production requires redis.
# SECURITY_COUNTER_STORE=redis
# New passwords are checked against Have I Been Pwned. best-effort (default)
# accepts a password when the service can't be reached and logs a warning;
# strict refuses to set passwords until it can be reached; off uses only the
# built-in list of common passwords (for servers without internet access).
# PASSWORD_BREACH_CHECK=best-effort
# Scanned (image-only) resume PDFs are read with Tesseract OCR inside the API;
# nothing is sent to an outside service. Takes a few seconds of CPU per page.
# Set false on servers with little CPU: such resumes then show a notice instead.
# RESUME_OCR=true
# Header written by a trusted edge IP-geolocation provider. Empty means country
# signals stay unavailable rather than client-controlled.
TRUSTED_IP_COUNTRY_HEADER=

# ---------------------------------------------------------------------------
# Object storage (TECH.md 12 - signed URLs only, never public buckets)
# In the compose stack these are also MinIO's root credentials.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tapcrm-files
# FS-6: statutory artifacts go to a separate write-once bucket with object lock.
S3_BUCKET_WORM=tapcrm-worm
S3_ACCESS_KEY_ID=replace-me-min-3-chars
S3_SECRET_ACCESS_KEY=replace-me-min-8-chars
S3_FORCE_PATH_STYLE=true
AUDIT_ARCHIVE_ENCRYPTION_KEY=replace-me-base64-32-byte-key
AUDIT_ARCHIVE_KEY_ID=replace-me-audit-archive-key-v1
# Optional JSON map of historical key IDs to base64-encoded 32-byte keys.
AUDIT_ARCHIVE_KEYRING_JSON=
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Identity (PRD ID-2, ID-6)
# ---------------------------------------------------------------------------
# 32+ characters each, and DIFFERENT. NODE_ENV=production refuses any value that
# starts with "replace-me". The geofence coordinate key is derived from the
# refresh secret, so rotating it makes stored coordinates unreadable.
JWT_ACCESS_SECRET=replace-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-me-generate-a-different-one-32-plus-chars
# ID-6: access tokens short-lived, default 60 minutes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# API and web
# ---------------------------------------------------------------------------
API_PORT=4000
CONTENT_COLLAB_PORT=4001
API_BASE_PATH=/api
WEB_PORT=5173
# The web app's public URL. The base of every emailed link. Required in production.
CLIENT_ORIGIN=http://localhost:5173
VITE_CONTENT_COLLAB_URL=ws://localhost:4001
# Not enforced today (no CORS middleware; the web app is same-origin via its proxy).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Audit writer (TECH.md 9.5.1)
# ---------------------------------------------------------------------------
# AUDIT_DRAINER_ENABLED=true
# AUDIT_DRAIN_INTERVAL_MS=5000
# AUDIT_DRAIN_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Notification engine (team-docs/guides/notifications/notification-engine-guide.md)
# ---------------------------------------------------------------------------
# NOTIFICATION_DISPATCHER_ENABLED=true
# NOTIFICATION_DISPATCH_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Platform / Tapvera Master Admin
# ---------------------------------------------------------------------------
# `npm run platform:admin` creates the account if missing and never changes an
# existing one; `npm run platform:admin:reset` replaces the password.
PLATFORM_ADMIN_EMAIL=master@tapvera.io
PLATFORM_ADMIN_NAME="Tapvera Master Admin"
# Required: 12+ characters. Refused if it is the retired development default.
PLATFORM_ADMIN_PASSWORD=replace-with-12-plus-character-secret
# Only for `npx tsx tools/api-test-suite.ts`: a tenant admin in your test tenant.
# TEST_TENANT_ADMIN_EMAIL=admin@tapvera.io
# TEST_TENANT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email. Sent through the BullMQ "email-queue" (Redis), one message per second.
# With no SMTP_* set, messages are printed to the API console.
# ---------------------------------------------------------------------------
# SMTP_HOST=mail.tapvera.io
# SMTP_PORT=465
# true = implicit TLS (port 465); false = STARTTLS (port 587).
# SMTP_SECURE=true
# SMTP_USER=no-reply@tapvera.io
# SMTP_PASSWORD=
# Required when SMTP is configured; there is no fallback sender address.
# SMTP_FROM=no-reply@tapvera.io
# Development-only demo employee fixture password. Never set this in production.
# DEMO_EMPLOYEE_PASSWORD=

# ---------------------------------------------------------------------------
# Google Search Console — automatic SEO keyword rank fetching.
# Setup runbook: team-docs/guides/seo/search-console-automation.md
#
# `off` (the default) leaves the scheduled jobs registered but inert.
#   service-account  recommended for a server: no token expiry to manage. The
#                    service-account email must be added as a user on each
#                    property (Restricted is enough to read search analytics).
#   oauth            uses an account that already owns the properties, so there
#                    is no per-property setup. The OAuth consent screen MUST be
#                    published to Production — Google expires a test-mode
#                    refresh token after 7 days and the job then fails daily.
# ---------------------------------------------------------------------------
# GOOGLE_SEARCH_CONSOLE_AUTH=off
# GOOGLE_SERVICE_ACCOUNT_EMAIL=tapcrm-seo@your-project.iam.gserviceaccount.com
# The `private_key` from the service-account JSON. Keep the \n escapes.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Search Console's most recent days are still being collected; observations are
# taken from a window ending this many days back.
# GOOGLE_SEARCH_CONSOLE_LAG_DAYS=3
# The window's length. One day is sparse — a low-impression keyword vanishes
# from it — so the default averages a week.
# GOOGLE_SEARCH_CONSOLE_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
# PageSpeed Insights (Lighthouse lab performance scores).
# Works WITHOUT a key at low rate limits (good for dev). With a key the quota
# lifts to 25k requests/day. Create one at console.cloud.google.com — enable the
# "PageSpeed Insights API" and generate an unrestricted API key.
# ---------------------------------------------------------------------------
# PAGESPEED_API_KEY=
# Optional separate key for the Chrome UX Report API. If omitted, the server
# tries PAGESPEED_API_KEY; its Google Cloud project must enable CrUX API access.
# CRUX_API_KEY=

# ---------------------------------------------------------------------------
# SerpAPI (SERP rank tracking). Without this, the SEO Rank Tracking panel
# shows "provider unavailable" rows but the job still fires so data flows
# the moment a key is set. Paid service — pricing per 1k searches.
# Get at https://serpapi.com.
# ---------------------------------------------------------------------------
# SERPAPI_API_KEY=

# ---------------------------------------------------------------------------
# Moz Links API (backlinks + domain authority). Without these credentials the
# Backlinks panel stays empty. Paid service — the seo:backlinks_fetch job
# calls Moz once per site per day. Get credentials at https://moz.com/products/api.
# ---------------------------------------------------------------------------
# MOZ_ACCESS_ID=
# MOZ_SECRET_KEY=

# ---------------------------------------------------------------------------
# Headless rendering (Playwright + Chromium). Set to 'true' to let the SEO
# crawler render JS-heavy pages (SPAs that only emit a skeleton in raw HTML).
# Requires a one-time:  npm install playwright && npx playwright install chromium
# When unset or false, the renderer returns state='disabled' and the C008
# raw-vs-rendered diff rule stays dormant. Raw-HTML audits run normally.
# ---------------------------------------------------------------------------
# SEO_RENDER_ENABLED=false

# ---------------------------------------------------------------------------
# Perplexity Sonar (AI Visibility). Without this, AI Visibility panel is
# empty. Paid service — pricing per 1k queries. Get at https://docs.perplexity.ai/
# One default prompt set is auto-seeded per site; users can add more prompts
# and target other platforms from the UI.
# ---------------------------------------------------------------------------
# PERPLEXITY_API_KEY=
# Optional override: 'sonar' (default) or 'sonar-pro' (deeper research).
# SEO_PERPLEXITY_MODEL=sonar

# Call Analytics (Sales → Call Integrations): JustCall and Aircall API keys that
# companies enter are stored encrypted with this key. Generate once with
# `openssl rand -hex 32`; keep it backed up and secret. Changing it makes saved
# keys unreadable (companies then re-enter them). Empty = the Call Integrations
# page explains that setup is pending. See team-docs/setup/call-analytics.md.
TELEPHONY_CREDENTIALS_KEY=

# Official social integrations: one developer application per platform for the CRM.
# See team-docs/setup/social-media.md and social-platforms.md.
# Public CRM origin (HTTPS in production); register each exact callback URL.
# Encryption key: generate once with openssl rand -hex 32; keep backed up and secret.
SOCIAL_PUBLIC_BASE_URL=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_META_API_VERSION=v24.0
SOCIAL_META_APPROVED=false
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_API_VERSION=202609
SOCIAL_LINKEDIN_APPROVED=false
SOCIAL_LINKEDIN_ORGANIZATIONS_ENABLED=false
SOCIAL_LINKEDIN_INSIGHTS_ENABLED=false
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GOOGLE_BUSINESS_APPROVED=false
SOCIAL_YOUTUBE_APPROVED=false
