# TapCRM environment template.
#
# TECH.md DP-3: secrets come from a managed secret store, never source files.
# This file documents the shape only. Copy it to .env and fill it in; never
# commit a filled-in .env.
#
# Generate a secret:   openssl rand -hex 32
#
# Docker Compose reads .env automatically. Every secret below is REQUIRED by
# `docker compose` (no fallback), so a missing one stops it with a message.
# The API itself reads process.env only and does not load this file: to run it
# on the host, export the values first:  set -a; source .env; set +a

NODE_ENV=development
LOG_LEVEL=debug

# Leave unset to exercise real Identity authentication. Set true only for local
# authorization-pipeline testing with x-dev-* headers. Refused when
# NODE_ENV=production. Booleans accept true/false/1/0/yes/no/on/off.
# IDENTITY_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# PostgreSQL (TECH.md PG-1: 18.x; PG-3: runtime role never has BYPASSRLS)
# ---------------------------------------------------------------------------
# Compose stack: these build both database URLs inside the containers.
POSTGRES_DB=tapcrm
POSTGRES_MIGRATOR_USER=tapcrm_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-me-generate-with-openssl
# The runtime role tapcrm_app. Set by `npm run db:app-password` after migrating
# (compose does this on every start); it is never written in a migration.
POSTGRES_APP_PASSWORD=replace-me-generate-with-openssl
# Host port the compose Postgres is published on (127.0.0.1 only).
POSTGRES_HOST_PORT=5432

# API on the host (not in compose): keep the passwords and port in step with the
# values above.
# The APPLICATION role. Owns no tables, cannot bypass RLS, has no UPDATE or
# DELETE on append-only tables. The only role the request path uses.
DATABASE_URL=postgres://tapcrm_app:replace-me@localhost:5432/tapcrm
# The MIGRATION/ADMIN role. Owns the tables. Used by migrations and seeds only,
# never by a serving process (TECH.md 4.2.1). Compose does not give it to the API.
MIGRATION_DATABASE_URL=postgres://tapcrm_migrator:replace-me@localhost:5432/tapcrm

# DP-8: pool size is budgeted, not guessed.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis (TECH.md 2.3 - session versions, permission sets, socket fan-out, queues)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379
# Where brute-force counters live. Production requires redis.
# SECURITY_COUNTER_STORE=redis
# Header written by a trusted edge IP-geolocation provider. Empty means country
# signals stay unavailable rather than client-controlled.
TRUSTED_IP_COUNTRY_HEADER=

# ---------------------------------------------------------------------------
# Object storage (TECH.md 12 - signed URLs only, never public buckets)
# In the compose stack these are also MinIO's root credentials.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tapcrm-files
# FS-6: statutory artifacts go to a separate write-once bucket with object lock.
S3_BUCKET_WORM=tapcrm-worm
S3_ACCESS_KEY_ID=replace-me-min-3-chars
S3_SECRET_ACCESS_KEY=replace-me-min-8-chars
S3_FORCE_PATH_STYLE=true
AUDIT_ARCHIVE_ENCRYPTION_KEY=replace-me-base64-32-byte-key
AUDIT_ARCHIVE_KEY_ID=replace-me-audit-archive-key-v1
# Optional JSON map of historical key IDs to base64-encoded 32-byte keys.
AUDIT_ARCHIVE_KEYRING_JSON=
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Identity (PRD ID-2, ID-6)
# ---------------------------------------------------------------------------
# 32+ characters each, and DIFFERENT. NODE_ENV=production refuses any value that
# starts with "replace-me". The geofence coordinate key is derived from the
# refresh secret, so rotating it makes stored coordinates unreadable.
JWT_ACCESS_SECRET=replace-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-me-generate-a-different-one-32-plus-chars
# ID-6: access tokens short-lived, default 60 minutes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# API and web
# ---------------------------------------------------------------------------
API_PORT=4000
API_BASE_PATH=/api
WEB_PORT=5173
# The web app's public URL. The base of every emailed link. Required in production.
CLIENT_ORIGIN=http://localhost:5173
# Not enforced today (no CORS middleware; the web app is same-origin via its proxy).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Audit writer (TECH.md 9.5.1)
# ---------------------------------------------------------------------------
# AUDIT_DRAINER_ENABLED=true
# AUDIT_DRAIN_INTERVAL_MS=5000
# AUDIT_DRAIN_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Platform / Tapvera Master Admin
# ---------------------------------------------------------------------------
# `npm run platform:admin` creates the account if missing and never changes an
# existing one; `npm run platform:admin:reset` replaces the password.
PLATFORM_ADMIN_EMAIL=master@tapvera.io
PLATFORM_ADMIN_NAME="Tapvera Master Admin"
# Required: 12+ characters. Refused if it is the retired development default.
PLATFORM_ADMIN_PASSWORD=replace-with-12-plus-character-secret

# ---------------------------------------------------------------------------
# Email. With no SMTP_* set, messages are printed to the API console.
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Leave unset for STARTTLS on 587; set true only for implicit TLS on 465.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Required when SMTP is configured; there is no fallback sender address.
# SMTP_FROM=
# Development-only demo employee fixture password. Never set this in production.
# DEMO_EMPLOYEE_PASSWORD=
