# TapCRM environment template.
#
# TECH.md DP-3: secrets come from a managed secret store, never source files.
# This file documents the shape only. Never commit a filled-in .env.

NODE_ENV=development
# Leave UNSET to exercise real Identity authentication. Only enable for explicit
# local authorization-pipeline testing with x-dev-* headers. Do not write
# IDENTITY_DEV_BYPASS=false: the config parser reads any non-empty string,
# including "false", as true.
# IDENTITY_DEV_BYPASS=true
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL (TECH.md PG-1: 18.x; PG-3: runtime role never has BYPASSRLS)
# ---------------------------------------------------------------------------
# The APPLICATION role. Owns no tables, cannot bypass RLS, has no UPDATE or
# DELETE on append-only tables. This is the only role the request path uses.
DATABASE_URL=postgres://tapcrm_app:app_dev_password@localhost:5432/tapcrm

# The MIGRATION/ADMIN role. Owns the tables. Used by migrations and seeds only,
# never by a serving process. Kept separate so a compromised app process cannot
# alter the schema or disable a policy (TECH.md §4.2.1).
MIGRATION_DATABASE_URL=postgres://tapcrm_migrator:migrator_dev_password@localhost:5432/tapcrm

# DP-8: pool size is budgeted, not guessed. api instances + workers must stay
# under the server's connection ceiling with headroom.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis (TECH.md §2.3 — session versions, permission sets, socket fan-out, queues)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
TRUSTED_IP_COUNTRY_HEADER=

# ---------------------------------------------------------------------------
# Object storage (TECH.md §12 — signed URLs only, never public buckets)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tapcrm-files
# FS-6: statutory artifacts (issued invoices, published payslips) go to a
# separate write-once bucket with object lock.
S3_BUCKET_WORM=tapcrm-worm
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Identity (PRD ID-2, ID-6)
# ---------------------------------------------------------------------------
# Argon2id per PRD ID-2 ("memory-hard algorithm at current-standard parameters")
JWT_ACCESS_SECRET=replace-me-in-every-real-environment
JWT_REFRESH_SECRET=replace-me-too-and-make-it-different
# ID-6: access tokens short-lived, default 60 minutes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=4000
API_BASE_PATH=/api
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Platform / Tapvera Master Admin
# ---------------------------------------------------------------------------
# Used only by `npm run platform:admin` to bootstrap/update the platform operator.
PLATFORM_ADMIN_EMAIL=master@tapvera.io
PLATFORM_ADMIN_NAME=Tapvera Master Admin
# Required. The bootstrap script refuses to run without it, and refuses the
# retired default. Existing accounts are never modified unless you run
# `npm run platform:admin:reset`.
PLATFORM_ADMIN_PASSWORD=replace-with-12-plus-character-secret
CLIENT_ORIGIN=http://localhost:5173
# ---------------------------------------------------------------------------
# Nodemailer Setup
# ---------------------------------------------------------------------------
# SMTP settings used for real email delivery. Leave SMTP_SECURE unset for
# STARTTLS on port 587 (the string "false" is currently parsed as true, which
# selects implicit TLS); set SMTP_SECURE=true only for port 465.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=your-email@example.com
